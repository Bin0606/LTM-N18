# Sao chép thành .env khi chạy local:  cp .env.example .env   (KHÔNG commit file .env)
# Trên Render: KHÔNG dùng file .env, hãy nhập các biến này trong Dashboard → Environment.

APP_ENV=development            # development | production
# Chuỗi ngẫu nhiên dài. Tạo bằng:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai

# ---------------- Database ----------------
# Để trống = dùng SQLite tại instance/connecthub.db (chỉ dùng khi phát triển).
# Production: Neon PostgreSQL (copy từ Neon Console → Connect). Nên dùng chuỗi có sslmode=require.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Chuỗi KẾT NỐI TRỰC TIẾP của Neon (hostname KHÔNG có "-pooler"), dùng riêng cho `flask db upgrade`.
# Neon khuyến nghị migration không chạy qua pooler. Để trống = dùng DATABASE_URL.
#   DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DIRECT_DATABASE_URL=

# ---------------- Lưu file ----------------
STORAGE_BACKEND=local          # local (chỉ để dev) | s3 (Cloudflare R2, production miễn phí)
UPLOAD_DIR=uploads             # chỉ dùng khi STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
# Cloudflare R2 (khi STORAGE_BACKEND=s3). Bucket phải để PRIVATE. Token R2 chỉ cấp quyền Object Read & Write cho đúng bucket.
S3_BUCKET=
S3_ENDPOINT_URL=               # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=connecthub/

# ---------------- Mạng / bảo mật / giới hạn ----------------
# Origin được phép mở WebSocket, phân tách bằng dấu phẩy. Để trống = chỉ cùng origin.
# Trên Render có thể để trống vì ứng dụng tự dùng RENDER_EXTERNAL_URL.
CORS_ORIGINS=
SESSION_COOKIE_SECURE=         # để trống: tự bật khi APP_ENV=production
MAX_MESSAGE_LENGTH=2000
MSG_RATE_COUNT=10              # tối đa N tin nhắn ...
MSG_RATE_WINDOW=10             # ... trong T giây cho mỗi người dùng
UPLOAD_RATE_COUNT=5            # tối đa N file ...
UPLOAD_RATE_WINDOW=60          # ... trong T giây cho mỗi tài khoản (vượt → HTTP 429)
REGISTER_RATE_COUNT=20         # số lần đăng ký tối đa mỗi giờ từ một IP (mạng trường dùng chung IP: đừng đặt quá thấp)
